# Wachtwoord voor het hele team. Verander je het, dan is iedereen uitgelogd.
APP_WACHTWOORD=

# Pincode voor het beheer (alleen cijfers, liefst 6 of meer). Verander je hem, dan moet iedereen opnieuw inloggen op het beheer.
BEHEER_PINCODE=

# Vercel Blob (Storage > Blob > Create, Private). Vercel zet deze zelf zodra je de store koppelt.
# De app logt in via OIDC (VERCEL_OIDC_TOKEN zet Vercel zelf). Een oudere koppeling met BLOB_READ_WRITE_TOKEN werkt ook.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
